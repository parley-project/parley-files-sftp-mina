<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- License, developer, SCM, URL, Java level and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-files-sftp-mina</artifactId>
	<version>1.1.0-SNAPSHOT</version>
	<name>Parley Files SFTP: Apache MINA SSHD</name>
	<description>The Apache MINA SSHD provider for parley-files-sftp. LIMITATION: it can't log in with an ssh-agent (auth=Agent); use a password or a key, or another provider.</description>

	<properties>
		<!-- Written to the jar manifest as Automatic-Module-Name -->
		<parley.moduleName>us.bringardner.parley.files.sftp.mina</parley.moduleName>
		<parley.version>1.0.0</parley.version>
		<!-- parley-files(-sftp) 1.1.0 add file locks -->
		<parley-files.version>1.1.0-SNAPSHOT</parley-files.version>
	</properties>

	<!-- GitHub Packages. Maven Central releases use: mvn -Prelease clean deploy -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>parley-project</name>
			<url>https://maven.pkg.github.com/parley-project/parley-files-sftp-mina</url>
		</repository>
	</distributionManagement>

	<build>
		<plugins>
			<!-- Attaches the -sources.jar. The version comes from parley-parent; package (not deploy)
			     so the source jar is attached BEFORE the deploy plugin runs. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>package</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Runs parley-files-sftp's provider test suite (its tests jar) against this provider,
			     with this project's own tests. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<dependenciesToScan>
						<dependency>us.bringardner.parley:parley-files-sftp</dependency>
					</dependenciesToScan>
					<!-- The suite's temporary folders go in target/, a path with no symbolic links in it. On macOS
					     the default one is under /var, a link to private/var, and the embedded test server's readlink
					     can't follow a relative link, so SftpCanonicalPathTest fails there. java.io.tmpdir is only
					     read when the JVM starts, so it has to be set here and not in systemPropertyVariables. -->
					<argLine>-Djava.io.tmpdir=${project.build.directory}</argLine>
					<systemPropertyVariables>
						<!-- What this library can't do (see the README): the suite skips those tests;
						     this project's own tests check that the provider refuses them. -->
						<parley.sftp.test.unsupported>agentLogin</parley.sftp.test.unsupported>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-sftp</artifactId>
			<version>${parley-files.version}</version>
		</dependency>
		<!-- Apache MINA SSHD client and SFTP (sshd-core and sshd-common come with it) -->
		<dependency>
			<groupId>org.apache.sshd</groupId>
			<artifactId>sshd-sftp</artifactId>
			<version>2.19.0</version>
		</dependency>
		<!-- Ed25519 keys for MINA SSHD; without it MINA cannot read Ed25519 private
		     keys or known_hosts files that contain Ed25519 entries -->
		<dependency>
			<groupId>net.i2p.crypto</groupId>
			<artifactId>eddsa</artifactId>
			<version>0.3.0</version>
		</dependency>

		<!-- The provider test suite and what it needs -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-sftp</artifactId>
			<version>${parley-files.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>${parley-files.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.13.4</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.sshtools</groupId>
			<artifactId>maverick-synergy-server</artifactId>
			<version>3.1.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.sshtools</groupId>
			<artifactId>maverick-virtual-session</artifactId>
			<version>3.1.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.sshtools</groupId>
			<artifactId>maverick-virtual-filesystem</artifactId>
			<version>3.1.2</version>
			<scope>test</scope>
		</dependency>
		<!-- A parley-ssh server for the ssh-agent test (it registers no provider) -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-ssh</artifactId>
			<version>${parley.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
